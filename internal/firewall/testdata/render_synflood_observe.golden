# Generated by litevirt firewall renderer — do not edit by hand.
# `nft -f -` consumes this file as an atomic ruleset replace.

table inet litevirt-fw {
    chain forward {
        type filter hook forward priority filter; policy accept;
        ct state established,related accept
        ct state invalid drop
        ip6 hoplimit != 255 icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } drop
        jump cluster_default
        jump host_overrides
    }

    chain cluster_default {
    }

    chain host_overrides {
    }

    chain isolated_forward {
        type filter hook forward priority filter; policy accept;
        iifgroup 27766 oifgroup != 27766 drop
        oifgroup 27766 iifgroup != 27766 drop
    }

}

table bridge litevirt-nic {
    set lv_nic_devs {
        type ifname
        elements = { "tap-a", "tap-b" }
    }

    set lv_vlan_ok {
        type ifname
    }

    set lv_dhcp_srv {
        type ifname
    }

    set lv_gw4 {
        type ipv4_addr
        flags interval
    }

    set lv_gw6 {
        type ipv6_addr
        flags interval
    }

    set lv_lb4 {
        type ipv4_addr . inet_service
    }

    set lv_lb_src4 {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.1 }
    }

    set lv_syn4 {
        type ifname . ipv4_addr
        size 65536
        flags dynamic,timeout
        timeout 60s
    }

    set lv_syn6 {
        type ifname . ipv6_addr
        size 65536
        flags dynamic,timeout
        timeout 60s
    }

    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        iifname != @lv_nic_devs accept
        iifname != @lv_vlan_ok ether type { 8021q, 8021ad } counter comment "lv-wd - vlan tagged"
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname != @lv_nic_devs oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } counter comment "lv-wd - vlan tagged-to-nic"
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        iifname @lv_nic_devs udp sport 68 udp dport 67 ip daddr 255.255.255.255 accept
        iifname @lv_nic_devs ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        iifname != @lv_nic_devs udp sport 67 udp dport 68 accept
        iifname != @lv_nic_devs ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname @lv_dhcp_srv udp sport 67 udp dport 68 accept
        iifname @lv_dhcp_srv ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname != @lv_nic_devs ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-redirect } accept
        iifname != @lv_nic_devs ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid counter comment "lv-wd - state invalid"
        iifname tap-a jump nic_out_tap_a
        iifname tap-b jump nic_out_tap_b
        oifname @lv_nic_devs meta protocol ip meta l4proto tcp tcp flags & (fin|syn|rst|ack) == syn ip saddr != @lv_lb_src4 update @lv_syn4 { oifname . ip saddr limit rate over 250/second burst 1500 packets } counter comment "lv-wd - in synflood"
        oifname @lv_nic_devs meta protocol ip6 meta l4proto tcp tcp flags & (fin|syn|rst|ack) == syn update @lv_syn6 { oifname . ip6 saddr limit rate over 250/second burst 1500 packets } counter comment "lv-wd - in synflood"
        oifname tap-a jump nic_in_tap_a
        oifname tap-b jump nic_in_tap_b
    }

    chain input {
        type filter hook input priority filter; policy accept;
        iifname != @lv_nic_devs accept
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        udp sport 68 udp dport 67 ip daddr { 255.255.255.255 } accept
        udp sport 68 udp dport 67 ip daddr @lv_gw4 accept
        ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        ip daddr @lv_gw4 udp dport 53 accept
        ip daddr @lv_gw4 tcp dport 53 accept
        ip6 daddr @lv_gw6 udp dport 53 accept
        ip6 daddr @lv_gw6 tcp dport 53 accept
        ct state invalid counter comment "lv-wd - state invalid"
        iifname tap-a jump nic_out_tap_a
        iifname tap-b jump nic_out_tap_b
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } counter comment "lv-wd - vlan tagged-to-nic"
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        ip saddr @lv_gw4 udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type nd-router-advert accept
        ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid counter comment "lv-wd - state invalid"
        oifname @lv_nic_devs meta protocol ip meta l4proto tcp tcp flags & (fin|syn|rst|ack) == syn ip saddr != @lv_lb_src4 update @lv_syn4 { oifname . ip saddr limit rate over 250/second burst 1500 packets } counter comment "lv-wd - in synflood"
        oifname @lv_nic_devs meta protocol ip6 meta l4proto tcp tcp flags & (fin|syn|rst|ack) == syn update @lv_syn6 { oifname . ip6 saddr limit rate over 250/second burst 1500 packets } counter comment "lv-wd - in synflood"
        oifname tap-a jump nic_in_tap_a
        oifname tap-b jump nic_in_tap_b
    }

    chain nic_out_tap_a {
    }

    chain nic_in_tap_a {
    }

    chain nic_out_tap_b {
    }

    chain nic_in_tap_b {
    }

}
