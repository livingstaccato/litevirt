version: 2
ethernets:
  eth0:
    match:
      macaddress: "52:54:00:00:05:01"
    dhcp4: true
    dhcp4-overrides:
      route-metric: 100
    dhcp6: true
    dhcp6-overrides:
      route-metric: 100
  eth1:
    match:
      macaddress: "52:54:00:00:05:02"
    addresses:
      - 10.201.0.20/24
    routes:
      - to: 0.0.0.0/0
        via: 10.201.0.1
        metric: 101
    nameservers:
      addresses:
        - 1.1.1.1
        - 8.8.8.8
