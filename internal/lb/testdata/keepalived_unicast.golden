
global_defs {
    enable_script_security
    script_user root
    vrrp_check_unicast_src
}

vrrp_script chk_haproxy {
    script "/usr/bin/pgrep -f app-haproxy.cfg"
    interval 2
    weight 2
    rise 2
    fall 3
}

vrrp_instance app {
    state MASTER
    interface eth0
    virtual_router_id 42
    priority 100
    advert_int 1

    unicast_src_ip 192.168.1.10
    unicast_peer {
        192.168.1.11
    }
    check_unicast_src

    track_interface {
        br-app
    }

    virtual_ipaddress {
        10.0.100.100/24 dev br-app
    }

    track_script {
        chk_haproxy
    }
}
