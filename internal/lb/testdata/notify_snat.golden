#!/bin/bash
CONF="/etc/litevirt/lb/egress-conntrackd.conf"
case "$1" in
    MASTER)
        conntrackd -C "$CONF" -c
        conntrackd -C "$CONF" -f
        conntrackd -C "$CONF" -R
        conntrackd -C "$CONF" -B
        ;;
    BACKUP)
        conntrackd -C "$CONF" -t
        conntrackd -C "$CONF" -n
        ;;
    FAULT)
        conntrackd -C "$CONF" -t
        ;;
esac
