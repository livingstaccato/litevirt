# Generated by litevirt firewall renderer — do not edit by hand.
# `nft -f -` consumes this file as an atomic ruleset replace.

table inet litevirt-fw {
    set trusted {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.0/24 }
    }

    set trusted_v6 {
        type ipv6_addr
        flags interval
        elements = { fd00::/64 }
    }

    limit lv_lg_routed {
        rate 20/second burst 40 packets
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        ip6 hoplimit != 255 icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } drop
        meta mark & 0x10000000 == 0x10000000 accept
        jump cluster_default
        jump host_overrides
    }

    chain cluster_default {
        tcp dport 25 limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - c0ffee drop"
        tcp dport 25 reject comment "no smtp"
        ip daddr 10.9.0.0/16 drop
    }

    chain host_overrides {
        udp dport 161 ip saddr @trusted limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - h1 accept"
        udp dport 161 ip6 saddr @trusted_v6 limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - h1 accept"
        udp dport 161 ip saddr @trusted accept
        udp dport 161 ip6 saddr @trusted_v6 accept
    }

    chain isolated_forward {
        type filter hook forward priority filter; policy accept;
        iifgroup 27766 oifgroup != 27766 drop
        oifgroup 27766 iifgroup != 27766 drop
    }

}

table bridge litevirt-nic {
    set lv_nic_devs {
        type ifname
        elements = { "tap-vm1-0", "veth.c1" }
    }

    set lv_vlan_ok {
        type ifname
    }

    set lv_dhcp_srv {
        type ifname
    }

    set lv_gw4 {
        type ipv4_addr
        flags interval
    }

    set lv_gw6 {
        type ipv6_addr
        flags interval
    }

    set trusted {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.0/24 }
    }

    set trusted_v6 {
        type ipv6_addr
        flags interval
        elements = { fd00::/64 }
    }

    set lv_lb4 {
        type ipv4_addr . inet_service
    }

    set lv_lb_src4 {
        type ipv4_addr
        flags interval
    }

    limit lv_lg_i_tap_vm1_0 {
        rate 20/second burst 40 packets
    }

    limit lv_lg_o_tap_vm1_0 {
        rate 20/second burst 40 packets
    }

    limit lv_lg_i_veth_c1 {
        rate 20/second burst 40 packets
    }

    limit lv_lg_o_veth_c1 {
        rate 20/second burst 40 packets
    }

    limit lv_lg_routed {
        rate 20/second burst 40 packets
    }

    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        iifname != @lv_nic_devs accept
        iifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname != @lv_nic_devs oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        iifname @lv_nic_devs udp sport 68 udp dport 67 ip daddr 255.255.255.255 accept
        iifname @lv_nic_devs ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        iifname != @lv_nic_devs udp sport 67 udp dport 68 accept
        iifname != @lv_nic_devs ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname @lv_dhcp_srv udp sport 67 udp dport 68 accept
        iifname @lv_dhcp_srv ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname != @lv_nic_devs ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-redirect } accept
        iifname != @lv_nic_devs ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid drop
        iifname tap-vm1-0 jump nic_out_tap_vm1_0
        iifname veth.c1 jump nic_out_veth_c1
        oifname tap-vm1-0 jump nic_in_tap_vm1_0
        oifname veth.c1 jump nic_in_veth_c1
    }

    chain input {
        type filter hook input priority filter; policy accept;
        iifname != @lv_nic_devs accept
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        udp sport 68 udp dport 67 ip daddr { 255.255.255.255 } accept
        udp sport 68 udp dport 67 ip daddr @lv_gw4 accept
        ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        ip daddr @lv_gw4 udp dport 53 accept
        ip daddr @lv_gw4 tcp dport 53 accept
        ip6 daddr @lv_gw6 udp dport 53 accept
        ip6 daddr @lv_gw6 tcp dport 53 accept
        ct state invalid drop
        iifname tap-vm1-0 jump nic_out_tap_vm1_0
        iifname veth.c1 jump nic_out_veth_c1
        meta mark set meta mark | 0x10000000
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oifname != @lv_nic_devs meta mark & 0x20000000 == 0x20000000 jump routed_to_port
        oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        ip saddr @lv_gw4 udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type nd-router-advert accept
        ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid drop
        oifname tap-vm1-0 jump nic_in_tap_vm1_0
        oifname veth.c1 jump nic_in_veth_c1
    }

    chain routed_to_port {
        tcp dport 25 limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - c0ffee drop"
        tcp dport 25 drop comment "no smtp"
        ip daddr 10.9.0.0/16 drop
        udp dport 161 ip saddr @trusted limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - h1 accept"
        udp dport 161 ip6 saddr @trusted_v6 limit name "lv_lg_routed" log group 27 snaplen 96 prefix "lv-log - - h1 accept"
        udp dport 161 ip saddr @trusted accept
        udp dport 161 ip6 saddr @trusted_v6 accept
        drop
    }

    chain nic_out_tap_vm1_0 {
        # cluster tier
        iifname tap-vm1-0 ip daddr 10.9.0.0/16 drop
        # host tier
        # security group "web"
        iifname tap-vm1-0 udp dport 53 limit name "lv_lg_o_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 out rule accept"
        iifname tap-vm1-0 udp dport 53 return
        limit name "lv_lg_o_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 out default drop"
        drop
    }

    chain nic_in_tap_vm1_0 {
        # cluster tier
        oifname tap-vm1-0 tcp dport 25 limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in c0ffee drop"
        oifname tap-vm1-0 tcp dport 25 drop comment "no smtp"
        # host tier
        oifname tap-vm1-0 udp dport 161 ip saddr @trusted limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in h1 accept"
        oifname tap-vm1-0 udp dport 161 ip6 saddr @trusted_v6 limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in h1 accept"
        oifname tap-vm1-0 udp dport 161 ip saddr @trusted accept
        oifname tap-vm1-0 udp dport 161 ip6 saddr @trusted_v6 accept
        # security group "web"
        oifname tap-vm1-0 tcp dport 22 ip saddr @trusted limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in s1 drop"
        oifname tap-vm1-0 tcp dport 22 ip6 saddr @trusted_v6 limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in s1 drop"
        oifname tap-vm1-0 tcp dport 22 ip saddr @trusted drop
        oifname tap-vm1-0 tcp dport 22 ip6 saddr @trusted_v6 drop
        oifname tap-vm1-0 tcp dport 443 accept
        limit name "lv_lg_i_tap_vm1_0" log group 27 snaplen 96 prefix "lv-log tap-vm1-0 in default drop"
        drop
    }

    chain nic_out_veth_c1 {
        # cluster tier
        iifname veth.c1 ip daddr 10.9.0.0/16 drop
        # host tier
        limit name "lv_lg_o_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 out default drop"
        drop
    }

    chain nic_in_veth_c1 {
        # cluster tier
        oifname veth.c1 tcp dport 25 limit name "lv_lg_i_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 in c0ffee drop"
        oifname veth.c1 tcp dport 25 drop comment "no smtp"
        # host tier
        oifname veth.c1 udp dport 161 ip saddr @trusted limit name "lv_lg_i_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 in h1 accept"
        oifname veth.c1 udp dport 161 ip6 saddr @trusted_v6 limit name "lv_lg_i_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 in h1 accept"
        oifname veth.c1 udp dport 161 ip saddr @trusted accept
        oifname veth.c1 udp dport 161 ip6 saddr @trusted_v6 accept
        oifname veth.c1 ip protocol icmp limit name "lv_lg_i_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 in n1 drop"
        oifname veth.c1 ip protocol icmp drop
        limit name "lv_lg_i_veth_c1" log group 27 snaplen 96 prefix "lv-log veth.c1 in default drop"
        drop
    }

}
