# Generated by litevirt firewall renderer — do not edit by hand.
# `nft -f -` consumes this file as an atomic ruleset replace.

table inet litevirt-fw {
    set trusted {
        type ipv4_addr
        flags interval
        elements = {  10.2.0.0/16, 10.0.0.0/24, 10.1.0.1-10.1.0.9 }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        ct state established,related accept
        ct state invalid drop
        ip6 hoplimit != 255 icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } drop
        meta mark & 0x10000000 == 0x10000000 accept
        jump cluster_default
        jump host_overrides
    }

    chain cluster_default {
        tcp dport { 80, 443 } accept comment "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        tcp dport !=22 ip saddr 10.0.0.1-10.0.0.9 drop comment "ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
        tcp dport < 1024 ip saddr != 10.0.0.0/8 reject
        ip protocol esp accept
        udp dport 8000 - 9000 ip saddr @trusted accept
        ip protocol esp accept
        tcp dport 22 accept
        tcp dport 3306 drop comment "a\\b"
        tcp dport ssh ip daddr  192.0.2.0/24 drop comment "a\nb"
        tcp dport { 22, 2222 } ip saddr !=@trusted drop
        udp dport 53 ip daddr gw.example.com accept
        ip protocol != tcp drop comment "it's"
        ip protocol { tcp, udp } ip saddr 198.51.100.0/24 accept
        tcp dport 8443 accept comment "per ticket #42; see wiki { x }"
    }

    chain host_overrides {
        udp dport eq 123 ip daddr { 10.0.0.1, 10.0.0.2 } drop
    }

}

table bridge litevirt-nic {
    set lv_nic_devs {
        type ifname
        elements = { "tap0" }
    }

    set lv_vlan_ok {
        type ifname
    }

    set lv_dhcp_srv {
        type ifname
    }

    set lv_gw4 {
        type ipv4_addr
        flags interval
    }

    set lv_gw6 {
        type ipv6_addr
        flags interval
    }

    set trusted {
        type ipv4_addr
        flags interval
        elements = {  10.2.0.0/16, 10.0.0.0/24, 10.1.0.1-10.1.0.9 }
    }

    set lv_lb4 {
        type ipv4_addr . inet_service
    }

    set lv_lb_src4 {
        type ipv4_addr
        flags interval
    }

    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        iifname != @lv_nic_devs accept
        iifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname != @lv_nic_devs oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        iifname @lv_nic_devs udp sport 68 udp dport 67 ip daddr 255.255.255.255 accept
        iifname @lv_nic_devs ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        iifname != @lv_nic_devs udp sport 67 udp dport 68 accept
        iifname != @lv_nic_devs ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname @lv_dhcp_srv udp sport 67 udp dport 68 accept
        iifname @lv_dhcp_srv ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname != @lv_nic_devs ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-redirect } accept
        iifname != @lv_nic_devs ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid drop
        iifname tap0 jump nic_out_tap0
        oifname tap0 jump nic_in_tap0
    }

    chain input {
        type filter hook input priority filter; policy accept;
        iifname != @lv_nic_devs accept
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        udp sport 68 udp dport 67 ip daddr { 255.255.255.255 } accept
        udp sport 68 udp dport 67 ip daddr @lv_gw4 accept
        ip6 saddr fe80::/10 ip6 daddr ff02::1:2 udp sport 546 udp dport 547 accept
        ip daddr @lv_gw4 udp dport 53 accept
        ip daddr @lv_gw4 tcp dport 53 accept
        ip6 daddr @lv_gw6 udp dport 53 accept
        ip6 daddr @lv_gw6 tcp dport 53 accept
        ct state invalid drop
        iifname tap0 jump nic_out_tap0
        meta mark set meta mark | 0x10000000
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oifname != @lv_nic_devs meta mark & 0x20000000 == 0x20000000 jump routed_to_port
        oifname != @lv_nic_devs accept
        oifname @lv_nic_devs oifname != @lv_vlan_ok ether type { 8021q, 8021ad } drop
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        ip6 hoplimit 255 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr { ::, fe80::/10 } ip6 daddr ff00::/8 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
        ip saddr @lv_gw4 udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type nd-router-advert accept
        ip saddr @lv_lb_src4 ip daddr . tcp dport @lv_lb4 accept
        ct state invalid drop
        oifname tap0 jump nic_in_tap0
    }

    chain routed_to_port {
        tcp dport { 80, 443 } accept comment "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        tcp dport !=22 ip saddr 10.0.0.1-10.0.0.9 drop comment "ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
        tcp dport < 1024 ip saddr != 10.0.0.0/8 drop
        ip protocol esp accept
        udp dport 8000 - 9000 ip saddr @trusted accept
        ip protocol esp accept
        tcp dport 22 accept
        tcp dport 3306 drop comment "a\\b"
        tcp dport ssh ip daddr  192.0.2.0/24 drop comment "a\nb"
        tcp dport { 22, 2222 } ip saddr !=@trusted drop
        udp dport 53 ip daddr gw.example.com accept
        ip protocol != tcp drop comment "it's"
        ip protocol { tcp, udp } ip saddr 198.51.100.0/24 accept
        tcp dport 8443 accept comment "per ticket #42; see wiki { x }"
        udp dport eq 123 ip daddr { 10.0.0.1, 10.0.0.2 } drop
    }

    chain nic_out_tap0 {
        # cluster tier
        iifname tap0 tcp dport ssh ip daddr  192.0.2.0/24 drop comment "a\nb"
        iifname tap0 udp dport 53 ip daddr gw.example.com return
        # host tier
        iifname tap0 udp dport eq 123 ip daddr { 10.0.0.1, 10.0.0.2 } drop
        # security group "web"
    }

    chain nic_in_tap0 {
        # cluster tier
        oifname tap0 tcp dport { 80, 443 } accept comment "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        oifname tap0 tcp dport !=22 ip saddr 10.0.0.1-10.0.0.9 drop comment "ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
        oifname tap0 tcp dport < 1024 ip saddr != 10.0.0.0/8 drop
        oifname tap0 ip protocol esp accept
        oifname tap0 udp dport 8000 - 9000 ip saddr @trusted accept
        oifname tap0 ip protocol esp accept
        oifname tap0 tcp dport 22 accept
        oifname tap0 tcp dport 3306 drop comment "a\\b"
        oifname tap0 tcp dport { 22, 2222 } ip saddr !=@trusted drop
        oifname tap0 ip protocol != tcp drop comment "it's"
        oifname tap0 ip protocol { tcp, udp } ip saddr 198.51.100.0/24 accept
        oifname tap0 tcp dport 8443 accept comment "per ticket #42; see wiki { x }"
        # host tier
        # security group "web"
        oifname tap0 tcp dport { 8080, 8443 } ip saddr @trusted accept
        oifname tap0 tcp dport 1-1023 drop
    }

}
