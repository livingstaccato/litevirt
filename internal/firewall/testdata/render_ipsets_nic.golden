# Generated by litevirt firewall renderer — do not edit by hand.
# `nft -f -` consumes this file as an atomic ruleset replace.

table inet litevirt-fw {
    set trusted {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.0/24, 10.0.1.0/24 }
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
        ct state invalid drop
        jump cluster_default
        jump host_overrides
    }

    chain cluster_default {
    }

    chain host_overrides {
    }

}

table bridge litevirt-nic {
    set trusted {
        type ipv4_addr
        flags interval
        elements = { 10.0.0.0/24, 10.0.1.0/24 }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
        udp sport 68 udp dport 67 accept
        udp sport 67 udp dport 68 accept
        udp sport 546 udp dport 547 accept
        udp sport 547 udp dport 546 accept
        ct state invalid drop
        iifname tap-vm1-0 jump nic_out_tap_vm1_0
        oifname tap-vm1-0 jump nic_in_tap_vm1_0
    }

    chain input {
        type filter hook input priority filter; policy accept;
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
        udp sport 68 udp dport 67 accept
        udp sport 67 udp dport 68 accept
        udp sport 546 udp dport 547 accept
        udp sport 547 udp dport 546 accept
        ct state invalid drop
        iifname tap-vm1-0 jump nic_out_tap_vm1_0
    }

    chain output {
        type filter hook output priority filter; policy accept;
        ct state established,related accept
        meta protocol != { ip, ip6 } accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
        udp sport 68 udp dport 67 accept
        udp sport 67 udp dport 68 accept
        udp sport 546 udp dport 547 accept
        udp sport 547 udp dport 546 accept
        ct state invalid drop
        oifname tap-vm1-0 jump nic_in_tap_vm1_0
    }

    chain nic_out_tap_vm1_0 {
        # security group "web"
        drop
    }

    chain nic_in_tap_vm1_0 {
        # security group "web"
        oifname tap-vm1-0 tcp dport 80 ip saddr @trusted accept
        oifname tap-vm1-0 tcp dport 443 ip saddr @trusted accept
        drop
    }

}
