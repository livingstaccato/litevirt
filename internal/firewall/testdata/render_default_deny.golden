        icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect } drop
        jump cluster_default
        jump host_overrides
    }

    chain cluster_default {
    }

    chain host_overrides {
